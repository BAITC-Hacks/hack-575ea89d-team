OPENAI_API_KEY=
# Set an OpenAI model that supports Responses API function calling.
OPENAI_MODEL=
# Optional, if the team decides to use NVIDIA as model provider:
NVIDIA_API_KEY=
NVIDIA_MODEL=

# Paths relative to backend/. Leave empty to use the team data and existing database.
NETWORK_DATA_DIR=
NETWORK_STATE_DB=
# Only needed for a separately hosted frontend; same-origin dashboard needs no CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
